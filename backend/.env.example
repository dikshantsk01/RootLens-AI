# KPI Intelligence-to-Action Engine — backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.

# Port the FastAPI backend listens on.
PORT=8000

# Path to the SQLite database file (relative to backend/ or absolute).
DATABASE_PATH=data/app.db

# Folder where raw uploaded source files are stored (relative to backend/ or absolute).
UPLOADS_DIR=data/uploads

# Gemini API key — required for Phase 10's LLM recommendation layer.
# Get one at https://aistudio.google.com/apikey. May be empty until then.
GEMINI_API_KEY=

# Gemini model for recommendations + published per-Mtok rates for cost estimation.
# Defaults below target gemini-3.6-flash pricing.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_INPUT_USD_PER_MTOK=0.10
GEMINI_OUTPUT_USD_PER_MTOK=0.40
